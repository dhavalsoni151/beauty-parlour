rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function memberOf(orgId) {
      return signedIn() && exists(
        /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)
      );
    }

    function roleOf(orgId) {
      return get(
        /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)
      ).data.role;
    }

    function ownerOrAdmin(orgId) {
      return memberOf(orgId) && roleOf(orgId) in ['owner', 'admin'];
    }

    function staffOrAbove(orgId) {
      return memberOf(orgId) && roleOf(orgId) in ['owner', 'admin', 'staff'];
    }

    function historicalCreateOnly() {
      return request.resource.data.record_type == 'historical_transaction'
        && request.resource.data._migration_fingerprint is string
        && request.resource.data._migration_path is string;
    }

    function mutableRecord() {
      return resource.data.record_type != 'historical_transaction'
        && request.resource.data.record_type != 'historical_transaction';
    }

    match /organizations/{orgId} {
      allow read: if memberOf(orgId);
      allow update: if ownerOrAdmin(orgId);
      allow create, delete: if false;

      match /members/{uid} {
        allow read: if memberOf(orgId) && (uid == request.auth.uid || ownerOrAdmin(orgId));
        allow create, update, delete: if ownerOrAdmin(orgId);
      }

      match /settings/{documentId} {
        allow read: if memberOf(orgId);
        allow create, update, delete: if ownerOrAdmin(orgId)
          && documentId != 'pin_hash' && documentId != 'pin_enabled';
      }

      match /customers/{documentId} {
        allow read: if memberOf(orgId);
        allow create, update: if staffOrAbove(orgId);
        allow delete: if ownerOrAdmin(orgId);
      }

      match /categories/{documentId} {
        allow read: if memberOf(orgId);
        allow create, update, delete: if ownerOrAdmin(orgId);
      }

      match /serviceTypes/{documentId} {
        allow read: if memberOf(orgId);
        allow create, update, delete: if ownerOrAdmin(orgId);
      }

      match /services/{documentId} {
        allow read: if memberOf(orgId);
        allow create, update, delete: if ownerOrAdmin(orgId);
      }

      match /packages/{documentId} {
        allow read: if memberOf(orgId);
        allow create, update: if ownerOrAdmin(orgId);
        allow delete: if false;
        match /items/{itemId} {
          allow read: if memberOf(orgId);
          allow create, update: if ownerOrAdmin(orgId);
          allow delete: if false;
        }
      }

      match /expenseCategories/{documentId} {
        allow read: if memberOf(orgId);
        allow create, update, delete: if ownerOrAdmin(orgId);
      }

      match /expenses/{documentId} {
        allow read: if memberOf(orgId);
        allow create, update: if staffOrAbove(orgId);
        allow delete: if ownerOrAdmin(orgId);
      }

      match /reminders/{documentId} {
        allow read: if memberOf(orgId);
        allow create, update: if staffOrAbove(orgId);
        allow delete: if ownerOrAdmin(orgId);
      }

      match /visits/{documentId} {
        allow read: if memberOf(orgId);
        allow create: if staffOrAbove(orgId) && historicalCreateOnly();
        allow update: if staffOrAbove(orgId) && mutableRecord();
        allow delete: if false;
        match /items/{itemId} {
          allow read: if memberOf(orgId);
          allow create: if staffOrAbove(orgId) && historicalCreateOnly();
          allow update, delete: if false;
        }
        match /payments/{paymentId} {
          allow read: if memberOf(orgId);
          allow create: if staffOrAbove(orgId) && historicalCreateOnly();
          allow update, delete: if false;
        }
        match /writeOffs/{writeOffId} {
          allow read: if memberOf(orgId);
          allow create: if ownerOrAdmin(orgId) && historicalCreateOnly();
          allow update, delete: if false;
        }
      }

      match /appointments/{documentId} {
        allow read: if memberOf(orgId);
        allow create: if staffOrAbove(orgId)
          && (request.resource.data.record_type != 'historical_transaction'
            || historicalCreateOnly());
        allow update: if staffOrAbove(orgId) && mutableRecord();
        allow delete: if ownerOrAdmin(orgId);
        match /items/{itemId} {
          allow read: if memberOf(orgId);
          allow create: if staffOrAbove(orgId)
            && (request.resource.data.record_type != 'historical_transaction'
              || historicalCreateOnly());
          allow update, delete: if staffOrAbove(orgId) && mutableRecord();
        }
      }

      match /_migrations/{migrationId} {
        allow read, write: if ownerOrAdmin(orgId);
      }
    }

    match /_system/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
